# ---------- Backend ----------
# OpenAI API key is OPTIONAL. Without it, /api/query returns the assembled
# prompt + retrieved chunks instead of a generated answer — the retrieval
# pipeline still runs end-to-end. The knowledge graph falls back to
# co-occurrence edges when no key is present.
OPENAI_API_KEY=

# Qdrant — defaults work for host-mode dev; docker compose overrides host to "qdrant".
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Models (defaults are sensible; override only if you want to swap)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LLM_MODEL=gpt-4o-mini

# Retrieval tuning
COLLECTION_NAME=technova_docs
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_RETRIEVAL=10
TOP_K_FINAL=5
RRF_K=60
DOCS_PATH=docs/
BM25_INDEX_PATH=backend/bm25_index.pkl

# ---------- Frontend ----------
# Create frontend/.env.local with this line (Next.js picks it up).
# NEXT_PUBLIC_API_URL=http://localhost:8000
